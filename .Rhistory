carregar_e_identificar_data <- function(arquivo_base = "dados/brpedf.rda") {
# Verificar se a base existe
if (file.exists(arquivo_base)) {
message(paste("📂 Carregando base existente:", arquivo_base))
# Carregar a base (assumindo que o objeto se chama 'brpedf')
load(arquivo_base)
# Verificar se o objeto existe
if (exists("brpedf")) {
# Verificar se a coluna 'dia' existe
if ("dia" %in% colnames(brpedf)) {
# Converter para Date se necessário
if (!inherits(brpedf$dia, "Date")) {
# Tenta converter - assumindo formato "YYYY-MM-DD" ou similar
brpedf$dia <- as.Date(brpedf$dia)
}
ultima_data <- max(brpedf$dia, na.rm = TRUE)
message(paste("📅 Última data encontrada na base:", ultima_data))
message(paste("📊 Total de registros na base:", nrow(brpedf)))
message(paste("📋 Colunas disponíveis:", paste(colnames(brpedf), collapse = ", ")))
return(list(
base = brpedf,
ultima_data = ultima_data,
objeto_nome = "brpedf"
))
} else {
stop("Coluna 'dia' não encontrada na base brpedf. Colunas disponíveis: ",
paste(colnames(brpedf), collapse = ", "))
}
} else {
stop("Objeto 'brpedf' não encontrado no arquivo .rda")
}
} else {
message("⚠️  Base 'brpedf.rda' não encontrada. Iniciando do zero...")
return(list(
base = NULL,
ultima_data = as.Date("2025-08-09"),  # Data inicial do seu projeto
objeto_nome = "brpedf"
))
}
}
carregar_e_identificar_data(arquivo_base = "brpedf.rda")
