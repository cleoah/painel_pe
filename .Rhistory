get_latest_era5_date <- function() {
# Baseado no erro que você teve, a última data disponível é 2026-05-30
# Vamos usar uma abordagem conservadora
today <- Sys.Date()
# Verificar se hoje é depois de 2026-05-30
if (today > as.Date("2026-05-30")) {
# Se for depois, a data máxima conhecida é 2026-05-30
# (enquanto dados de junho+ não estiverem disponíveis)
latest_possible <- as.Date("2026-05-30")
message(paste("📡 Última data disponível no ERA5 (conhecida):", latest_possible))
} else {
# Se for antes, usa hoje - 3 dias (delay típico)
latest_possible <- today - 3
message(paste("📡 Estimativa da última data disponível no ERA5:", latest_possible))
}
return(latest_possible)
}
